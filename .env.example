# Production settings for scripts/prod.sh. Copy to .env and fill in; .env is git-ignored, keep it private.

# Domain whose DNS A (and AAAA, if any) record points to this server. HTTPS is set up automatically.
DOMAIN=news.example.com
# E-mail for Let's Encrypt notices (certificate problems).
ACME_EMAIL=you@example.com
# Database password, letters and digits only. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Source registry in backend/config/ (written by `scripts/prod.sh verify-sources`).
GEONEWS_SOURCES=sources.ru.yaml
# How the collector introduces itself to news sites: put a contact they can reach (keep the quotes).
GEONEWS_USER_AGENT="GeoNewsBot/1.0 (+https://news.example.com; you@example.com)"

# Sizing for a 4 GB RAM server (for 8 GB: PG_SHARED_BUFFERS=2GB, PG_EFFECTIVE_CACHE=6GB, API_WORKERS=4).
API_WORKERS=2
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB

# Backups in ./backups: one dump every N hours, keep the newest N dumps.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=7
